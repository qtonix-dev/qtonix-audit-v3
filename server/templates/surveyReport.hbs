<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{survey.name}} — Survey Report</title>
<style>
{{#if forWeb}}
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap');
{{else}}
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-Regular.ttf'); font-weight:400; }
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-Medium.ttf'); font-weight:500; }
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-Bold.ttf'); font-weight:700; }
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-ExtraBold.ttf'); font-weight:800; }
{{/if}}

:root{
  --navy:#0A0E27; --blue:#005AFF; --ink:#0A0E27; --muted:#6B7280;
  --line:#E5E7EB; --red:#E5484D; --green:#16A34A; --amber:#F59E0B;
  --tint:#EEF3FF; --tint-accent:#FFF4EC;
}

@page{ size: Letter; margin: 0; }
@page interior{ size: Letter; margin: 0.87in 0.87in 0.7in 0.87in; }

*{ box-sizing:border-box; margin:0; padding:0; }
body{ font-family:'Plus Jakarta Sans',system-ui,sans-serif; color:var(--ink); font-size:10.5pt; line-height:1.5; }

/* ---- Cover ---- */
.cover{
  page: cover;
  height:100vh; width:100%;
  background:linear-gradient(150deg,#0A0E28 0%,#0435AC 100%);
  color:#fff; padding:0.95in 0.87in; position:relative;
}
.cover .brand{ font-size:15pt; font-weight:800; letter-spacing:-.3px; }
.cover .brand span{ color:#FF6A00; }
.cover .kicker{ margin-top:2.4in; font-size:11pt; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#8FB4FF; }
.cover h1{ font-size:34pt; font-weight:800; line-height:1.08; margin-top:12px; max-width:8in; }
.cover .sub{ margin-top:14px; font-size:12pt; color:#C9D8FF; font-weight:500; }
.cover .meta{ position:absolute; bottom:0.95in; left:0.87in; right:0.87in; display:flex; gap:26px; border-top:1px solid rgba(255,255,255,.2); padding-top:14px; font-size:9.5pt; }
.cover .meta b{ display:block; color:#8FB4FF; font-size:8pt; text-transform:uppercase; letter-spacing:1px; margin-bottom:2px; font-weight:700; }

/* ---- Interior ---- */
.interior{ page: interior; }
.section{ margin-bottom:22px; }
.section.break{ break-before:page; }
h2{ font-size:15pt; font-weight:800; color:var(--blue); margin-bottom:4px; letter-spacing:-.2px; }
h2 .n{ color:var(--navy); }
.lead{ color:var(--muted); font-size:10pt; margin-bottom:12px; }
h3{ font-size:11.5pt; font-weight:800; color:var(--navy); margin:14px 0 8px; }

.summary-card{ background:var(--tint); border-radius:12px; padding:16px 18px; font-size:10.5pt; line-height:1.6; color:#243; }

/* Sentiment stat row */
.stats{ display:flex; gap:12px; margin:14px 0; }
.stat{ flex:1; border:1px solid var(--line); border-radius:12px; padding:14px; text-align:center; }
.stat .v{ font-size:24pt; font-weight:800; line-height:1; }
.stat .l{ font-size:8.5pt; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); margin-top:6px; font-weight:700; }

/* Bars */
.bar{ height:11px; border-radius:6px; background:#EEF1F6; overflow:hidden; display:flex; }
.bar i{ display:block; height:100%; }
.rowline{ display:flex; align-items:center; gap:10px; margin:7px 0; }
.rowline .name{ width:1.7in; font-weight:700; font-size:9.5pt; }
.rowline .barwrap{ flex:1; }
.rowline .num{ width:1.1in; text-align:right; font-size:8.5pt; color:var(--muted); }

/* Two-column good/improve */
.cols{ display:flex; gap:14px; }
.col{ flex:1; border:1px solid var(--line); border-radius:12px; padding:14px 16px; }
.col.good{ border-color:#BBF7D0; background:#F0FDF4; }
.col.improve{ border-color:#FDE68A; background:#FFFBEB; }
.col h4{ font-size:10.5pt; font-weight:800; margin-bottom:8px; }
.col.good h4{ color:#15803D; } .col.improve h4{ color:#B45309; }
.col ol{ padding-left:16px; } .col li{ font-size:9.5pt; margin-bottom:5px; line-height:1.45; }

/* Action lists */
.action{ border:1px solid var(--line); border-left:4px solid var(--blue); border-radius:8px; padding:12px 14px; margin-bottom:10px; }
.action.hr{ border-left-color:#0EA5E9; } .action.mgr{ border-left-color:#F59E0B; } .action.mgmt{ border-left-color:#8B5CF6; }
.action h4{ font-size:10.5pt; font-weight:800; margin-bottom:6px; color:var(--navy); }
.action ul{ padding-left:16px; } .action li{ font-size:9.5pt; margin-bottom:4px; }

/* People cards */
.person{ display:flex; gap:10px; align-items:flex-start; border:1px solid var(--line); border-radius:9px; padding:10px 12px; margin-bottom:8px; break-inside:avoid; }
.person .tag{ font-size:7.5pt; font-weight:800; text-transform:uppercase; letter-spacing:.4px; padding:3px 7px; border-radius:20px; white-space:nowrap; }
.tag.neg{ background:#FEE2E2; color:#B91C1C; } .tag.neu{ background:#FEF3C7; color:#B45309; } .tag.pos{ background:#DCFCE7; color:#15803D; }
.person .body b{ font-size:10pt; } .person .body p{ font-size:9pt; color:var(--muted); margin-top:2px; }

.empty{ color:var(--muted); font-size:9.5pt; font-style:italic; padding:6px 0; }
.pill{ display:inline-block; font-size:8pt; font-weight:800; text-transform:uppercase; letter-spacing:.5px; padding:3px 9px; border-radius:20px; background:var(--tint); color:var(--blue); }
.note{ font-size:8.5pt; color:var(--muted); margin-top:16px; border-top:1px solid var(--line); padding-top:8px; }
</style>
</head>
<body>

<div class="cover">
  <div class="brand">Qtonix<span>.</span></div>
  <div class="kicker">Employee Survey Report</div>
  <h1>{{survey.name}}</h1>
  <div class="sub">Sentiment &amp; feedback analysis for leadership</div>
  <div class="meta">
    <div><b>Period</b>{{period}}</div>
    <div><b>Responses</b>{{total}} of {{participants}}</div>
    <div><b>Generated</b>{{generatedAt}}</div>
  </div>
</div>

<div class="interior">
  <!-- Overview -->
  <div class="section">
    <h2>1. <span class="n">Overview</span></h2>
    <div class="lead">How the team is feeling this period, at a glance.</div>
    <div class="stats">
      <div class="stat"><div class="v" style="color:var(--green)">{{sentiment.positive}}%</div><div class="l">Positive</div></div>
      <div class="stat"><div class="v" style="color:var(--amber)">{{sentiment.neutral}}%</div><div class="l">Neutral</div></div>
      <div class="stat"><div class="v" style="color:var(--red)">{{sentiment.negative}}%</div><div class="l">Negative</div></div>
      <div class="stat"><div class="v" style="color:var(--navy)">{{completionPct}}%</div><div class="l">Completion</div></div>
    </div>
    {{#if summary}}<div class="summary-card">{{summary}}</div>{{/if}}
  </div>

  <!-- Good / Improve -->
  {{#if hasThemes}}
  <div class="section">
    <h2>2. <span class="n">What's working &amp; what to improve</span></h2>
    <div class="cols">
      <div class="col good"><h4>Top strengths</h4><ol>{{#each good}}<li>{{this}}</li>{{/each}}</ol></div>
      <div class="col improve"><h4>Top areas to improve</h4><ol>{{#each improve}}<li>{{this}}</li>{{/each}}</ol></div>
    </div>
  </div>
  {{/if}}

  <!-- By department -->
  {{#if byDepartment.length}}
  <div class="section">
    <h2>3. <span class="n">By department</span></h2>
    <div class="lead">Sentiment split and a short read for each department.</div>
    {{#each byDepartment}}
    <div style="margin-bottom:12px; break-inside:avoid;">
      <div class="rowline">
        <div class="name">{{this.key}}</div>
        <div class="barwrap"><div class="bar"><i style="width:{{this.positive}}%;background:var(--green)"></i><i style="width:{{this.neutral}}%;background:var(--amber)"></i><i style="width:{{this.negative}}%;background:var(--red)"></i></div></div>
        <div class="num">{{this.count}} resp · {{this.avgScore}}/5</div>
      </div>
      {{#if this.summary}}<div style="font-size:9pt;color:var(--muted);padding-left:calc(1.7in + 10px);">{{this.summary}}</div>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- Employees needing attention -->
  <div class="section break">
    <h2>4. <span class="n">Employees who need attention</span></h2>
    <div class="lead">Flagged from low scores, negative sentiment or guarded responses.</div>
    {{#if insights.attention.length}}
      {{#each insights.attention}}<div class="person"><span class="tag neg">Attention</span><div class="body"><b>{{this.name}}</b><p>{{this.reason}}</p></div></div>{{/each}}
    {{else}}<div class="empty">No employees flagged for immediate attention this period.</div>{{/if}}
  </div>

  <!-- One to one -->
  <div class="section">
    <h2>5. <span class="n">Recommended 1:1 conversations</span></h2>
    <div class="lead">People who would benefit from a direct, supportive check-in.</div>
    {{#if insights.oneToOne.length}}
      {{#each insights.oneToOne}}<div class="person"><span class="tag neu">1:1</span><div class="body"><b>{{this.name}}</b><p>{{this.reason}}</p></div></div>{{/each}}
    {{else}}<div class="empty">No specific 1:1s recommended this period.</div>{{/if}}
  </div>

  <!-- Action points -->
  <div class="section break">
    <h2>6. <span class="n">Recommended actions</span></h2>
    <div class="lead">Concrete next steps, grouped by who should own them.</div>
    <div class="action hr"><h4>Points to discuss with HR</h4>{{#if insights.forHR.length}}<ul>{{#each insights.forHR}}<li>{{this}}</li>{{/each}}</ul>{{else}}<div class="empty">Nothing specific for HR this period.</div>{{/if}}</div>
    <div class="action mgr"><h4>Points for the Team Lead / Manager</h4>{{#if insights.forManager.length}}<ul>{{#each insights.forManager}}<li>{{this}}</li>{{/each}}</ul>{{else}}<div class="empty">Nothing specific for managers this period.</div>{{/if}}</div>
    <div class="action mgmt"><h4>Actions for management</h4>{{#if insights.forManagement.length}}<ul>{{#each insights.forManagement}}<li>{{this}}</li>{{/each}}</ul>{{else}}<div class="empty">Nothing specific for management this period.</div>{{/if}}</div>
  </div>

  <!-- Individual reads -->
  {{#if people.length}}
  <div class="section break">
    <h2>7. <span class="n">Individual responses</span></h2>
    <div class="lead">The AI's read of what each person appears to think and feel.</div>
    {{#each people}}
    <div class="person"><span class="tag {{this.cls}}">{{this.sentiment}}</span><div class="body"><b>{{this.name}}</b> <span style="color:var(--muted);font-size:8.5pt;">· {{this.department}} · {{this.avgScore}}/5</span><p>{{this.summary}}</p></div></div>
    {{/each}}
  </div>
  {{/if}}

  <div class="note">Confidential — generated by Qtonix people-analytics AI. Sentiment is an AI estimate from survey responses and behaviour signals, intended to guide human judgement, not replace it.</div>
</div>

</body>
</html>

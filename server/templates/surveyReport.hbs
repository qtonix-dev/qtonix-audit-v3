<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{survey.name}} — Survey Report</title>
<style>
{{#if forWeb}}
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap');
{{else}}
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-Regular.ttf'); font-weight:400; }
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-Medium.ttf'); font-weight:500; }
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-Bold.ttf'); font-weight:700; }
@font-face { font-family:'Plus Jakarta Sans'; src:url('{{fontDir}}/PlusJakartaSans-ExtraBold.ttf'); font-weight:800; }
{{/if}}

:root{
  --navy:#0A0E27; --blue:#005AFF; --ink:#0A0E27; --muted:#6B7280;
  --line:#E5E7EB; --red:#E5484D; --green:#16A34A; --amber:#F59E0B;
  --tint:#EEF3FF;
}
*{ box-sizing:border-box; margin:0; padding:0; }
body{ font-family:'Plus Jakarta Sans',system-ui,sans-serif; color:var(--ink); font-size:10.5pt; line-height:1.55; }

{{#unless forWeb}}
@page{ size:Letter; margin:0.7in 0.8in; }
/* Each top-level .page block starts on a fresh sheet (the cover is first, so it
   doesn't need one before it). This gives deterministic pagination. */
.page{ break-before:page; }
.page:first-of-type{ break-before:auto; }
{{/unless}}

{{#if forWeb}}
body{ background:#F3F4F6; padding:1px 0; }
.page{ max-width:8.1in; margin:20px auto; background:#fff; padding:0.7in 0.8in; box-shadow:0 1px 8px rgba(0,0,0,.08); border-radius:4px; }
.cover.page{ padding:0; box-shadow:0 1px 8px rgba(0,0,0,.08); }
{{/if}}

/* ---------- Cover ---------- */
.cover{
  background:linear-gradient(150deg,#0A0E28 0%,#0435AC 100%);
  color:#fff; padding:0.9in 0.8in;
  {{#unless forWeb}}height:9.6in;{{/unless}}
  {{#if forWeb}}border-radius:4px; min-height:8.6in; display:flex; flex-direction:column;{{/if}}
  position:relative; break-after:page;
}
.cover .brand{ font-size:15pt; font-weight:800; }
.cover .brand span{ color:#FF6A00; }
{{#unless forWeb}}
/* PDF: place the title block a third of the way down and pin meta to the bottom. */
.cover .cbody{ margin-top:2.1in; }
.cover .meta{ position:absolute; bottom:0.9in; left:0.8in; right:0.8in; }
{{/unless}}
{{#if forWeb}}
/* Web: flex column centers the title and drops meta to the bottom of the card. */
.cover .cbody{ margin-top:auto; margin-bottom:auto; padding:0.3in 0; }
{{/if}}
.cover .kicker{ font-size:11pt; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#8FB4FF; }
.cover h1{ font-size:32pt; font-weight:800; line-height:1.08; margin-top:12px; }
.cover .sub{ margin-top:14px; font-size:12pt; color:#C9D8FF; font-weight:500; }
.cover .meta{ display:flex; gap:26px; border-top:1px solid rgba(255,255,255,.2); padding-top:14px; font-size:9.5pt; }
.cover .meta b{ display:block; color:#8FB4FF; font-size:8pt; text-transform:uppercase; letter-spacing:1px; margin-bottom:2px; font-weight:700; }

/* ---------- Sections ---------- */
h2{ font-size:15pt; font-weight:800; color:var(--blue); margin:0 0 3px; }
h2 .n{ color:var(--navy); }
h2 .num{ color:#9AB2E8; font-weight:800; margin-right:4px; }
.lead{ color:var(--muted); font-size:9.5pt; margin-bottom:10px; }
.section{ margin-bottom:20px; }
.avoid{ break-inside:avoid; }

.summary-card{ background:var(--tint); border-radius:12px; padding:15px 18px; font-size:10.5pt; line-height:1.65; color:#233; }

.stats{ display:flex; gap:10px; margin:12px 0; }
.stat{ flex:1; border:1px solid var(--line); border-radius:11px; padding:12px 8px; text-align:center; }
.stat .v{ font-size:21pt; font-weight:800; line-height:1; }
.stat .l{ font-size:8pt; text-transform:uppercase; letter-spacing:.5px; color:var(--muted); margin-top:5px; font-weight:700; }

.bar{ height:10px; border-radius:6px; background:#EEF1F6; overflow:hidden; display:flex; }
.bar i{ display:block; height:100%; }
.rowline{ display:flex; align-items:center; gap:10px; margin:6px 0; }
.rowline .name{ width:1.6in; font-weight:700; font-size:9.5pt; }
.rowline .barwrap{ flex:1; }
.rowline .num{ width:1.15in; text-align:right; font-size:8.5pt; color:var(--muted); }

.cols{ display:flex; gap:12px; }
.col{ flex:1; border:1px solid var(--line); border-radius:11px; padding:13px 15px; }
.col.good{ border-color:#BBF7D0; background:#F0FDF4; }
.col.improve{ border-color:#FDE68A; background:#FFFBEB; }
.col h4{ font-size:10pt; margin-bottom:7px; font-weight:800; }
.col.good h4{ color:#15803D; } .col.improve h4{ color:#B45309; }
.col ol{ padding-left:15px; } .col li{ font-size:9.5pt; margin-bottom:5px; line-height:1.45; }

/* Branch card */
.branch{ border:1px solid var(--line); border-radius:13px; padding:16px 18px; margin-bottom:16px; }
.branch .head{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:8px; }
.branch .bname{ font-size:13pt; font-weight:800; color:var(--navy); }
.branch .bmeta{ font-size:8.5pt; color:var(--muted); font-weight:700; }
.branch .bsum{ font-size:9.7pt; line-height:1.6; color:#333; background:#F8FAFF; border-radius:9px; padding:11px 13px; margin:8px 0 12px; }
.team{ border-top:1px solid var(--line); padding-top:9px; margin-top:9px; }
.team .tname{ font-weight:800; font-size:9.7pt; color:var(--navy); }

/* People */
.person{ display:flex; gap:10px; align-items:flex-start; border:1px solid var(--line); border-radius:9px; padding:10px 12px; margin-bottom:8px; break-inside:avoid; }
.person .tag{ font-size:7.5pt; font-weight:800; text-transform:uppercase; letter-spacing:.4px; padding:3px 7px; border-radius:20px; white-space:nowrap; }
.tag.neg{ background:#FEE2E2; color:#B91C1C; } .tag.neu{ background:#FEF3C7; color:#B45309; } .tag.pos{ background:#DCFCE7; color:#15803D; }
.person .body b{ font-size:10pt; } .person .body .role{ color:var(--muted); font-size:8.5pt; font-weight:600; }
.person .body p{ font-size:9pt; color:#444; margin-top:3px; line-height:1.5; }
.person .rec{ margin-top:5px; font-size:8.7pt; color:#1D4ED8; background:#EFF5FF; border-radius:6px; padding:5px 8px; }

/* Action plan */
.action{ border:1px solid var(--line); border-radius:11px; padding:0; margin-bottom:12px; overflow:hidden; break-inside:avoid; }
.action .ahead{ padding:9px 14px; font-size:10.5pt; font-weight:800; color:#fff; }
.action.hr .ahead{ background:#0EA5E9; } .action.mgr .ahead{ background:#F59E0B; } .action.mgmt .ahead{ background:#8B5CF6; }
.aitem{ padding:10px 14px; border-top:1px solid var(--line); }
.aitem .act{ font-weight:800; font-size:9.8pt; color:var(--navy); }
.aitem .meta{ font-size:8.8pt; color:#444; margin-top:3px; line-height:1.5; }
.aitem .meta .k{ font-weight:800; color:var(--muted); text-transform:uppercase; font-size:7.5pt; letter-spacing:.4px; }

.empty{ color:var(--muted); font-size:9.3pt; font-style:italic; padding:5px 0; }
.note{ font-size:8.3pt; color:var(--muted); margin-top:16px; border-top:1px solid var(--line); padding-top:8px; }
</style>
</head>
<body>

<div class="cover page">
  <div class="brand">Qtonix<span>.</span></div>
  <div class="cbody">
    <div class="kicker">Employee Survey Report</div>
    <h1>{{survey.name}}</h1>
    <div class="sub">Sentiment &amp; feedback analysis for leadership</div>
  </div>
  <div class="meta">
    <div><b>Period</b>{{period}}</div>
    <div><b>Responses</b>{{total}} of {{participants}}</div>
    <div><b>Generated</b>{{generatedAt}}</div>
  </div>
</div>

<div class="page">
  <div class="section avoid">
    <h2><span class="num">1.</span><span class="n">Overview</span></h2>
    <div class="lead">How the whole team is feeling this period, at a glance.</div>
    <div class="stats">
      <div class="stat"><div class="v" style="color:var(--green)">{{sentiment.positive}}%</div><div class="l">Positive</div></div>
      <div class="stat"><div class="v" style="color:var(--amber)">{{sentiment.neutral}}%</div><div class="l">Neutral</div></div>
      <div class="stat"><div class="v" style="color:var(--red)">{{sentiment.negative}}%</div><div class="l">Negative</div></div>
      <div class="stat"><div class="v" style="color:var(--navy)">{{completionPct}}%</div><div class="l">Completion</div></div>
    </div>
    {{#if summary}}<div class="summary-card">{{summary}}</div>{{/if}}
  </div>

  {{#if hasThemes}}
  <div class="section avoid">
    <h2><span class="num">2.</span><span class="n">What's working &amp; what to improve</span></h2>
    <div class="cols">
      <div class="col good"><h4>Top strengths</h4><ol>{{#each good}}<li>{{this}}</li>{{/each}}</ol></div>
      <div class="col improve"><h4>Top areas to improve</h4><ol>{{#each improve}}<li>{{this}}</li>{{/each}}</ol></div>
    </div>
  </div>
  {{/if}}
</div>

{{#if hasBranches}}
<div class="page">
  <div class="section">
    <h2><span class="num">3.</span><span class="n">By branch &amp; team</span></h2>
    <div class="lead">Each office broken down by its teams, with a read of how that branch is feeling and its people.</div>
    {{#each branches}}
    <div class="branch">
      <div class="head">
        <div class="bname">{{this.name}}</div>
        <div class="bmeta">{{this.count}} responses · avg {{this.avgScore}}/5</div>
      </div>
      <div class="rowline">
        <div class="name" style="width:1.0in;">Sentiment</div>
        <div class="barwrap"><div class="bar"><i style="width:{{this.positive}}%;background:var(--green)"></i><i style="width:{{this.neutral}}%;background:var(--amber)"></i><i style="width:{{this.negative}}%;background:var(--red)"></i></div></div>
        <div class="num">{{this.positive}}% pos · {{this.negative}}% neg</div>
      </div>
      {{#if this.summary}}<div class="bsum">{{this.summary}}</div>{{/if}}
      {{#each this.teams}}
      <div class="team">
        <div class="rowline">
          <div class="name tname">{{this.name}}</div>
          <div class="barwrap"><div class="bar"><i style="width:{{this.positive}}%;background:var(--green)"></i><i style="width:{{this.neutral}}%;background:var(--amber)"></i><i style="width:{{this.negative}}%;background:var(--red)"></i></div></div>
          <div class="num">{{this.count}} resp · {{this.avgScore}}/5</div>
        </div>
        {{#each this.people}}
        <div class="person">
          <span class="tag {{this.cls}}">{{this.sentiment}}</span>
          <div class="body">
            <b>{{this.name}}</b> <span class="role">· {{this.avgScore}}/5</span>
            <p>{{this.summary}}</p>
            {{#if this.recommendation}}<div class="rec"><b>Suggested next step:</b> {{this.recommendation}}</div>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
</div>
{{/if}}

<div class="page">
  <div class="section avoid">
    <h2><span class="num">4.</span><span class="n">Employees who need attention</span></h2>
    <div class="lead">Flagged from low scores, negative sentiment or guarded responses.</div>
    {{#if insights.attention.length}}
      {{#each insights.attention}}<div class="person"><span class="tag neg">Attention</span><div class="body"><b>{{this.name}}</b><p>{{this.reason}}</p></div></div>{{/each}}
    {{else}}<div class="empty">No employees flagged for immediate attention this period.</div>{{/if}}
  </div>

  <div class="section avoid">
    <h2><span class="num">5.</span><span class="n">Recommended 1:1 conversations</span></h2>
    <div class="lead">People who would benefit from a direct, supportive check-in.</div>
    {{#if insights.oneToOne.length}}
      {{#each insights.oneToOne}}<div class="person"><span class="tag neu">1:1</span><div class="body"><b>{{this.name}}</b><p>{{this.reason}}</p></div></div>{{/each}}
    {{else}}<div class="empty">No specific 1:1s recommended this period.</div>{{/if}}
  </div>

  {{#unless sixSeparate}}
  <div class="section">
    <h2><span class="num">6.</span><span class="n">Action plan</span></h2>
    <div class="lead">Clear next steps, grouped by who should own them — each with the reason and a practical first step.</div>
    <div class="action hr avoid"><div class="ahead">For HR</div>
      {{#if insights.forHR.length}}{{#each insights.forHR}}<div class="aitem"><div class="act">{{this.action}}</div>{{#if this.why}}<div class="meta"><span class="k">Why:</span> {{this.why}}</div>{{/if}}{{#if this.how}}<div class="meta"><span class="k">First step:</span> {{this.how}}</div>{{/if}}</div>{{/each}}{{else}}<div class="aitem empty">Nothing specific for HR this period.</div>{{/if}}
    </div>
    <div class="action mgr avoid"><div class="ahead">For the Team Lead / Manager</div>
      {{#if insights.forManager.length}}{{#each insights.forManager}}<div class="aitem"><div class="act">{{this.action}}</div>{{#if this.why}}<div class="meta"><span class="k">Why:</span> {{this.why}}</div>{{/if}}{{#if this.how}}<div class="meta"><span class="k">First step:</span> {{this.how}}</div>{{/if}}</div>{{/each}}{{else}}<div class="aitem empty">Nothing specific for managers this period.</div>{{/if}}
    </div>
    <div class="action mgmt avoid"><div class="ahead">For Management</div>
      {{#if insights.forManagement.length}}{{#each insights.forManagement}}<div class="aitem"><div class="act">{{this.action}}</div>{{#if this.why}}<div class="meta"><span class="k">Why:</span> {{this.why}}</div>{{/if}}{{#if this.how}}<div class="meta"><span class="k">First step:</span> {{this.how}}</div>{{/if}}</div>{{/each}}{{else}}<div class="aitem empty">Nothing specific for management this period.</div>{{/if}}
    </div>
    <div class="note">Confidential — generated by Qtonix people-analytics AI. Sentiment is an AI estimate from survey responses and behaviour signals, intended to guide human judgement, not replace it.</div>
  </div>
  {{/unless}}
</div>

{{#if sixSeparate}}
<div class="page">
  <div class="section">
    <h2><span class="num">6.</span><span class="n">Action plan</span></h2>
    <div class="lead">Clear next steps, grouped by who should own them — each with the reason and a practical first step.</div>
    <div class="action hr avoid"><div class="ahead">For HR</div>
      {{#if insights.forHR.length}}{{#each insights.forHR}}<div class="aitem"><div class="act">{{this.action}}</div>{{#if this.why}}<div class="meta"><span class="k">Why:</span> {{this.why}}</div>{{/if}}{{#if this.how}}<div class="meta"><span class="k">First step:</span> {{this.how}}</div>{{/if}}</div>{{/each}}{{else}}<div class="aitem empty">Nothing specific for HR this period.</div>{{/if}}
    </div>
    <div class="action mgr avoid"><div class="ahead">For the Team Lead / Manager</div>
      {{#if insights.forManager.length}}{{#each insights.forManager}}<div class="aitem"><div class="act">{{this.action}}</div>{{#if this.why}}<div class="meta"><span class="k">Why:</span> {{this.why}}</div>{{/if}}{{#if this.how}}<div class="meta"><span class="k">First step:</span> {{this.how}}</div>{{/if}}</div>{{/each}}{{else}}<div class="aitem empty">Nothing specific for managers this period.</div>{{/if}}
    </div>
    <div class="action mgmt avoid"><div class="ahead">For Management</div>
      {{#if insights.forManagement.length}}{{#each insights.forManagement}}<div class="aitem"><div class="act">{{this.action}}</div>{{#if this.why}}<div class="meta"><span class="k">Why:</span> {{this.why}}</div>{{/if}}{{#if this.how}}<div class="meta"><span class="k">First step:</span> {{this.how}}</div>{{/if}}</div>{{/each}}{{else}}<div class="aitem empty">Nothing specific for management this period.</div>{{/if}}
    </div>
    <div class="note">Confidential — generated by Qtonix people-analytics AI. Sentiment is an AI estimate from survey responses and behaviour signals, intended to guide human judgement, not replace it.</div>
  </div>
</div>
{{/if}}

</body>
</html>

    <table>
      <tr><th>Issue</th><th>What we saw</th><th style="width:22mm">Priority</th></tr>
      {{#each tech.clientRows}}<tr><td><b>{{this.issue}}</b></td><td>{{{this.sawHtml}}}</td><td><span class="pill {{this.pill}}">{{this.priority}}</span></td></tr>
      {{/each}}
    </table>
    <h3>{{h.competitor}} — issues found</h3>
    <table>
      <tr><th>Issue</th><th>What we saw</th></tr>
      {{#each tech.compRows}}<tr><td><b>{{this.issue}}</b></td><td>{{{this.sawHtml}}}</td></tr>
      {{/each}}
    </table>
  </div>
  <div class="ftr"><span>Qtonix Software Pvt. Ltd. · Confidential</span><span class="pn">08</span></div>

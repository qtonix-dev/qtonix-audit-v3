      <div class="sw o"><h4>Opportunities for {{h.client}}</h4><ul>{{#each swot.opportunities}}<li>{{{this}}}</li>{{/each}}</ul></div>
      <div class="sw t"><h4>Threats to {{h.client}}</h4><ul>{{#each swot.threats}}<li>{{{this}}}</li>{{/each}}</ul></div>

<section class="sheet">
  <div class="hdr"><div class="logo">Qtonix<b style="color:var(--orange)">.</b></div><div>Competitor Analysis · {{h.client}} vs {{h.competitor}}</div></div>
  <div class="content">
    <div class="eyebrow">07 · Backlink comparison</div>
    <h2>{{back.title}}</h2>
    <p>{{back.lead}}</p>
    <div class="legend"><span><i class="b-oc"></i>{{h.client}}</span><span><i style="background:#8C94AB"></i>{{h.competitor}}</span></div>
    <div class="bars">
      {{#each back.bars}}<div class="brow"><div class="lbl">{{this.label}}</div><div class="bpair"><div class="bar b-oc" style="width:{{this.clientPct}}%">{{this.clientVal}}</div><div class="bar b-fy" style="width:{{this.compPct}}%">{{this.compVal}}</div></div></div>
      {{/each}}
    </div>
    {{#if back.refDomains}}{{#if back.refDomains.client.length}}
    <h3>Top referring domains</h3>
    <p class="rdintro">The strongest sites linking to each domain, by link authority (0–100). A “Review” flag marks address endings commonly used by low-quality or paid links — a prompt to check them, not a verdict.</p>
    <div class="two rdtwo">
      <div>
        <div class="rdhead"><span class="dot" style="background:var(--orange)"></span>{{back.refDomains.clientName}}</div>
        <table class="rdtable">
          <tr><th>Domain</th><th class="num">Auth.</th><th class="num">Links</th><th></th></tr>
          {{#each back.refDomains.client}}<tr><td>{{this.domain}}</td><td class="num">{{this.authority}}</td><td class="num">{{this.backlinks}}</td><td>{{#if this.flag}}<span class="pill {{this.pill}}">{{this.flag}}</span>{{/if}}</td></tr>
          {{/each}}
        </table>
      </div>
      <div>
        <div class="rdhead"><span class="dot" style="background:var(--muted)"></span>{{back.refDomains.competitorName}}</div>
        <table class="rdtable">
          <tr><th>Domain</th><th class="num">Auth.</th><th class="num">Links</th><th></th></tr>
          {{#each back.refDomains.competitor}}<tr><td>{{this.domain}}</td><td class="num">{{this.authority}}</td><td class="num">{{this.backlinks}}</td><td>{{#if this.flag}}<span class="pill {{this.pill}}">{{this.flag}}</span>{{/if}}</td></tr>
          {{/each}}
        </table>
      </div>
    </div>
    {{/if}}{{/if}}
    <div class="two">
      <div class="card"><h4><span class="dot" style="background:var(--muted)"></span>{{h.competitor}}</h4><ul>{{#each back.compPoints}}<li>{{{this}}}</li>{{/each}}</ul></div>
      <div class="card"><h4><span class="dot" style="background:var(--orange)"></span>{{h.client}}</h4><ul>{{#each back.clientPoints}}<li>{{{this}}}</li>{{/each}}</ul></div>
    </div>
    {{#if back.risks}}
    <h3>{{back.risksTitle}}</h3>
    <table>
      <tr><th>Risk</th><th>Detail</th><th style="width:22mm">Priority</th></tr>
      {{#each back.risks}}<tr><td><b>{{this.risk}}</b></td><td>{{{this.detailHtml}}}</td><td><span class="pill {{this.pill}}">{{this.priority}}</span></td></tr>
      {{/each}}
    </table>
    {{/if}}
  </div>
  <div class="ftr"><span>Qtonix Software Pvt. Ltd. · Confidential</span><span class="pn">09</span></div>
</section>

<section class="sheet">
